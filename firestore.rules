rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email != ''
          ? request.auth.token.email.lower()
          : '';
    }

    function isAdmin() {
      return authEmail() != ''
        && exists(/databases/$(database)/documents/admins/$(authEmail()));
    }

    // ── Admin collection ──
    match /admins/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Local users ──
    // Dev: allow unauthenticated read/update for unsigned macOS builds where
    // Firebase Auth keychain access fails.
    match /local_users/{docId} {
      allow read: if isSignedIn() || request.auth == null;
      allow create: if isSignedIn() && authEmail() == docId;
      allow update: if (isSignedIn() && authEmail() == docId) || isAdmin() || request.auth == null;
      allow delete: if isAdmin();

      // FCM device tokens for push notifications. Users may only manage their
      // own tokens; admins (Cloud Functions) may write tokens server-side.
      match /fcmTokens/{token} {
        allow read: if isSignedIn() && authEmail() == docId;
        allow create, update: if (isSignedIn() && authEmail() == docId) || isAdmin();
        allow delete: if (isSignedIn() && authEmail() == docId) || isAdmin();
      }

      // In-app notification log for business owners. Owners may mark their
      // own notifications read/unread and clear them; only admins create them.
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && authEmail() == docId;
        allow create: if isAdmin();
        allow update, delete: if (isSignedIn() && authEmail() == docId) || isAdmin();
      }
    }

    // ── Visitor users ──
    // Dev: allow unauthenticated read/update for unsigned macOS builds where
    // Firebase Auth keychain access fails.
    match /visitor_users/{docId} {
      allow read: if isSignedIn() || request.auth == null;
      allow create: if isSignedIn() && authEmail() == docId;
      allow update: if (isSignedIn() && authEmail() == docId) || isAdmin() || request.auth == null;
      allow delete: if isAdmin();

      // FCM device tokens for visitor push notifications.
      match /fcmTokens/{token} {
        allow read: if isSignedIn() && authEmail() == docId;
        allow create, update: if (isSignedIn() && authEmail() == docId) || isAdmin();
        allow delete: if isSignedIn() && authEmail() == docId;
      }

      // In-app notification log for visitors. Visitors may mark their own
      // notifications read/unread and clear them; only admins create them.
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && authEmail() == docId;
        allow create: if isAdmin();
        allow update, delete: if (isSignedIn() && authEmail() == docId) || isAdmin();
      }
    }

    // ── Events ──
    match /events/{eventId} {
      allow read: if true; // Allow public read
      allow create: if isSignedIn() || request.auth == null; // Dev: allow unauthenticated
      allow update: if isSignedIn()
        && (resource.data.createdByLocalEmail == authEmail() || isAdmin());
      allow delete: if isSignedIn()
        && (resource.data.createdByLocalEmail == authEmail() || isAdmin());
    }

    // ── Approved Attractions (for web app) ──
    match /approved_attractions/{docId} {
      allow read: if true; // Allow public read
      allow write: if isAdmin() || request.auth == null; // Dev: allow unauthenticated
    }

    // ── Attraction details ──
    match /attraction_details/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Event reports ──
    match /event_reports/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Review reports ──
    match /review_reports/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Photo reports ──
    match /photo_reports/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() || request.auth == null;
      allow update, delete: if isAdmin();
    }

    // ── App feedback ──
    // Anonymous/guest users can submit feedback, so validate the payload.
    match /app_feedback/{docId} {
      allow read: if isSignedIn();
      allow create: if request.resource.data.keys().hasAll([
          'referenceId', 'reporterRole', 'reporterEmail', 'reporterName',
          'subject', 'details', 'category', 'severity', 'status',
          'consideredForFix', 'maintenanceWindowDays', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.reporterEmail is string
        && request.resource.data.reporterEmail.size() > 0
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0;
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Moderation audit log ──
    // Immutable records of admin moderation decisions.
    match /moderation_audit_log/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['adminEmail', 'contentType', 'contentId', 'decision', 'reason', 'createdAt'])
        && request.resource.data.adminEmail == authEmail();
      allow update, delete: if false;
    }

    // ── Mail queue (consumed by extensions) ──
    match /mail/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ── SMS queue ──
    match /sms_queue/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Notification health checks ──
    // Synthetic monitor results; written by Cloud Functions only.
    match /notification_health_checks/{docId} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isAdmin();
    }

    // ── User notifications ──
    match /user_notifications/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Admin platform notifications ──
    // One doc per admin, keyed by adminEmail. Admins may read/mark-read/clear
    // their own notifications; only Cloud Functions (Admin SDK) create them.
    match /admin_notifications/{docId} {
      allow read: if isSignedIn() && resource.data.adminEmail == authEmail();
      allow create: if isAdmin();
      allow update, delete: if isSignedIn() && resource.data.adminEmail == authEmail();
    }

    // ── Admin messages ──
    match /admin_messages/{docId} {
      allow read: if isSignedIn()
        && (resource.data.to == authEmail() || isAdmin());
      allow create: if isAdmin();
      allow update: if isSignedIn()
        && (resource.data.to == authEmail() || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Brisbane stories & voices (read-only, seeded server-side) ──
    match /brisbane_stories/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /brisbane_voices/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Discover items (seeded, read by all) ──
    match /discover_items/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Seed metadata ──
    match /seed_metadata/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Counters (auto-increment IDs for feedback etc.) ──
    match /counters/{docId} {
      allow read, write: if true;
    }

    // ── Config (event categories etc.) ──
    match /config/{docId} {
      allow read: if true; // Allow public read
      allow write: if isAdmin();
    }
    
    // ── Event categories (for web app) ──
    match /event_categories/{docId} {
      allow read: if true; // Allow public read
      allow write: if isAdmin() || request.auth == null; // Dev: allow unauthenticated
    }

    // ── Connectivity probe ──
    match /_connectivity_probe/{docId} {
      allow read: if isSignedIn();
    }

    // ── Business profiles (local business owner management) ──
    // Dev: allow unauthenticated create/update for unsigned macOS builds where
    // Firebase Auth keychain access fails. Restrict to authenticated owners
    // before production.
    //
    // Public reads are allowed for all visitors; active/deleted filtering is
    // applied in the app so that query orderings do not each require a
    // separate composite index and so signed-in visitors can discover listings.
    match /businesses/{businessId} {
      allow read: if true;
      // Owners create their own listing (ownerId must match); admins may
      // create listings on behalf of a business (e.g. unclaimed/imported
      // listings), regardless of the ownerId value.
      allow create: if (isSignedIn() && request.resource.data.ownerId == authEmail())
        || isAdmin()
        || request.auth == null;
      allow update: if isSignedIn() && (
        resource.data.ownerId == authEmail()
        || isAdmin()
        // Any signed-in visitor may update the public rating aggregates after
        // submitting a review.
        || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['averageRating', 'reviewCount', 'rating', 'buzzRating', 'updatedAt'])
      ) || request.auth == null;
      // Admin-only soft-delete (archive). Hard deletes happen via Cloud Function
      // after the archive retention window.
      allow delete: if isAdmin();

      // Dev: nested reviews subcollection for unsigned macOS builds.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth == null || isSignedIn();
        allow update, delete: if isSignedIn() || request.auth == null;
      }
    }

    // ── Business archive (soft-deleted listings) ──
    // Only admins can read/write. Permanent deletion is done by Cloud Function.
    match /business_archive/{businessId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Business verification audit log ──
    // Admins write; any signed-in user can read the log for a business.
    match /business_verification_log/{logId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['businessId', 'adminEmail', 'action', 'verifiedAt']);
      allow update, delete: if false;
    }

    // ── Promotion plans (admin-configurable) ──
    // Public read so visitors and business owners can view available plans.
    match /promotion_plans/{planId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Promotion payments ──
    // Written by Cloud Functions/webhook; owners and admins may read.
    match /business_payments/{paymentId} {
      allow read: if isSignedIn()
        && (resource.data.ownerId == authEmail() || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ── Reviews / Recommendations (visitor feedback on businesses) ──
    // Dev: allow unauthenticated reads/writes for unsigned macOS builds.
    match /reviews/{reviewId} {
      // Public reads see visible reviews only. Authors and admins can read
      // their own reviews (including non-visible/draft) so ownership checks
      // and duplicate-review queries work.
      allow read: if resource.data.visible == true
        || resource.data.visitorId == request.auth.uid
        || isAdmin()
        || request.auth == null;

      // Authenticated visitors can create one recommendation per business.
      // Rate limits are enforced client-side; rules guarantee auth binding
      // and data shape so fake/spam payloads are rejected.
      // Dev: allow unauthenticated creates for unsigned macOS builds.
      allow create: if (isSignedIn()
        && request.resource.data.visitorId == request.auth.uid
        && request.resource.data.businessId is string
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 500
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.buzzRating is int
        && request.resource.data.buzzRating >= 0
        && request.resource.data.buzzRating <= 5
        && request.resource.data.visible == true)
        || request.auth == null;

      // Owners can soft-delete their own recommendations. Admins can perform
      // any update (report, flag, restore, moderate). Any signed-in visitor
      // (not just the author) can mark a review helpful or report it, since
      // those are third-party actions on someone else's review.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.visitorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deletedAt', 'deletedBy', 'visible', 'updatedAt'])
      ) || (
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['helpfulCount', 'helpfulBy', 'updatedAt'])
      ) || (
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isReported', 'reportReason', 'reportedBy', 'severity', 'visible', 'updatedAt'])
      ) || request.auth == null;

      // Hard delete is reserved for admins only so history is preserved.
      allow delete: if isAdmin() || request.auth == null;
    }

    // ── Post engagements (likes, saves, buzz votes) ──
    // One document per visitor+post+action so duplicate engagement is blocked
    // at the ID level. Visitors can only create/delete their own engagements.
    match /post_engagements/{engagementId} {
      allow read: if isSignedIn() || request.auth == null;
      allow create: if (isSignedIn()
        && request.resource.data.keys().hasAll(['postType', 'postId', 'action', 'visitorId', 'createdAt'])
        && request.resource.data.postType is string
        && request.resource.data.postId is string
        && request.resource.data.action is string
        && request.resource.data.action in ['like', 'save', 'buzzVote']
        && request.resource.data.visitorId == request.auth.uid
        && request.resource.data.createdAt == request.time)
        || request.auth == null;
      allow delete: if (isSignedIn()
        && resource.data.visitorId == request.auth.uid)
        || request.auth == null;
      allow update: if false;
    }

    // ── Post comments (visitor comments on activity feed posts) ──
    // Visitors can create comments on any post. Authors can delete their own.
    // Text may be empty only when a photo/video attachment is included.
    match /post_comments/{commentId} {
      allow read: if isSignedIn() || request.auth == null;
      allow create: if (isSignedIn()
        && request.resource.data.keys().hasAll(['postType', 'postId', 'visitorId', 'visitorName', 'text', 'createdAt'])
        && request.resource.data.postType is string
        && request.resource.data.postId is string
        && request.resource.data.visitorId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && (request.resource.data.text.size() > 0
            || (request.resource.data.get('mediaUrl', '') is string
                && request.resource.data.get('mediaUrl', '').size() > 0))
        && request.resource.data.createdAt == request.time)
        || request.auth == null;
      allow update: if false;
      allow delete: if (isSignedIn()
        && resource.data.visitorId == request.auth.uid)
        || isAdmin()
        || request.auth == null;
    }

    // ── Food businesses (public read, seeding allows unauthenticated write) ──
    match /food_businesses/{businessId} {
      allow read: if true; // Allow public read
      allow write: if isAdmin() || request.auth == null; // Dev: allow unauthenticated for seeding
    }

    // ── Crowd reports (public read, authenticated create with cooldown enforced client-side) ──
    match /crowd_reports/{reportId} {
      allow read: if true || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['eventId', 'level', 'weight', 'timestamp'])
        && request.resource.data.eventId is string
        && request.resource.data.level is string
        && request.resource.data.weight is int
        && request.resource.data.timestamp is timestamp;
      allow update, delete: if false;
    }

    // ── Admin dashboard analytics collections ──
    match /business_payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Subscription plans (admin-configurable) ──
    // Public read so visitors and business owners can view available plans.
    match /subscription_plans/{planId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Business subscriptions ──
    // Written by Cloud Functions/webhook; owners may read their own document
    // and admins may read/write all documents.
    match /business_subscriptions/{subscriptionId} {
      allow read: if isSignedIn()
        && (subscriptionId == authEmail() || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /admin_activity/{activityId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Audience interactions (anonymised engagement analytics) ──
    // Business owners can read interactions for businesses they own.
    // Any signed-in visitor can record an anonymised view/save interaction.
    // Dev: allow unauthenticated reads for unsigned macOS builds.
    match /audience_interactions/{interactionId} {
      allow read: if (isSignedIn() && resource.data.ownerId == authEmail()) || isAdmin() || request.auth == null;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll(['businessId', 'ownerId', 'visitorHash', 'type', 'timestamp'])
        && request.resource.data.businessId is string
        && request.resource.data.ownerId is string
        && request.resource.data.visitorHash is string
        && request.resource.data.type is string
        && request.resource.data.timestamp is timestamp;
      allow update, delete: if false;
    }

    // ── Business events (local business owner events) ──
    // Dev: allow unauthenticated reads for unsigned macOS builds.
    match /business_events/{eventId} {
      allow read: if resource.data.status == 'published'
        || (isSignedIn() && resource.data.ownerId == authEmail())
        || request.auth == null;
      allow create: if isSignedIn() && request.resource.data.ownerId == authEmail();
      allow update: if isSignedIn() && (
        resource.data.ownerId == authEmail() || isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.ownerId == authEmail() || isAdmin()
      );
    }

    // ── Promotions (local business owner promotions) ──
    // Dev: allow unauthenticated reads/writes for unsigned macOS builds.
    match /promotions/{promotionId} {
      allow read: if resource.data.status in ['active', 'scheduled']
        || (isSignedIn() && resource.data.ownerId == authEmail())
        || request.auth == null;
      allow create: if (isSignedIn() && request.resource.data.ownerId == authEmail()) || request.auth == null;
      allow update: if isSignedIn() && (
        resource.data.ownerId == authEmail() || isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.ownerId == authEmail() || isAdmin()
      );
    }

    // ── AI-generated posts (drafts and published posts) ──
    // Published posts are public so they can appear in the Vendor Feed.
    // Drafts are only readable by their owner. Dev: unauthenticated fallbacks
    // remain for unsigned macOS builds.
    match /ai_generated_posts/{postId} {
      allow read: if resource.data.status == 'published'
        || (isSignedIn() && resource.data.ownerId == authEmail())
        || request.auth == null;
      allow create: if (isSignedIn() && request.resource.data.ownerId == authEmail()) || request.auth == null;
      allow update: if isSignedIn() && (
        resource.data.ownerId == authEmail() || isAdmin()
      ) || request.auth == null;
      allow delete: if isSignedIn() && (
        resource.data.ownerId == authEmail() || isAdmin()
      );
    }

    // ── Social shares / tags (visitor sharing to social media) ──
    // Records when visitors share or tag a business on social media.
    // Business owners can read shares for their own businesses. Signed-in
    // visitors can create shares. Dev: unauthenticated fallbacks remain for
    // unsigned macOS builds.
    match /social_shares/{shareId} {
      allow read: if (isSignedIn() && resource.data.businessId is string
        && exists(/databases/$(database)/documents/businesses/$(resource.data.businessId))
        && get(/databases/$(database)/documents/businesses/$(resource.data.businessId)).data.ownerId == authEmail())
        || isAdmin()
        || request.auth == null;
      allow create: if (isSignedIn()
        && request.resource.data.keys().hasAll(['visitorId', 'businessId', 'contentId', 'contentType', 'platform', 'shareKind', 'title', 'createdAt'])
        && request.resource.data.visitorId == request.auth.uid
        && request.resource.data.businessId is string
        && request.resource.data.contentId is string
        && request.resource.data.platform is string
        && request.resource.data.shareKind is string
        && request.resource.data.title is string
        && request.resource.data.createdAt == request.time)
        || request.auth == null;
      allow update, delete: if false;
    }

    // ── Visitor-contributed photos (businesses and events) ──
    // Public reads only see approved photos. Signed-in visitors can create
    // photos linked to their own auth uid. Authors and admins can update or
    // delete. Dev: allow unauthenticated writes for unsigned macOS builds.
    match /visitor_photos/{photoId} {
      allow read: if true;
      allow create: if (isSignedIn() && request.resource.data.visitorId == request.auth.uid)
        || request.auth == null;
      allow update: if (isSignedIn() && (resource.data.visitorId == request.auth.uid || isAdmin()))
        || request.auth == null;
      allow delete: if (isSignedIn() && (resource.data.visitorId == request.auth.uid || isAdmin()))
        || request.auth == null;
    }

    // ── Admin AI Alerts (platform insights generated by AI monitoring) ──
    // Admins only. Created and read by the AdminAiAlertService.
    match /admin_ai_alerts/{alertId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Google Listings Monitoring (Google Places vs BrisConnect comparison) ──
    // Admin-only audit trail of listing comparisons and review decisions.
    // Created by scheduled Cloud Function; managed by admin service.
    match /google_listing_monitoring/{recordId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
